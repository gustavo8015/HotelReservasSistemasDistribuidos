# Copie este archivo como .env antes de levantar los contenedores y cambie los valores.
# El archivo .env no debe subirse al repositorio: ya está excluido en .gitignore.

# Contraseña del usuario sa de SQL Server. Mínimo ocho caracteres con mayúsculas,
# minúsculas, dígitos y algún símbolo, o el contenedor no arranca.
SQL_PASSWORD=Cambie_Esta_Clave_2026*

# Clave de firma de los tokens. Mínimo 32 caracteres.
JWT_KEY=cambie-esta-clave-por-una-de-al-menos-32-caracteres

# Proveedor del modelo del asistente. Si se dejan vacíos, responde el intérprete de
# reglas, que no necesita internet ni cuenta.
ASISTENTE_BASEURL=
ASISTENTE_APIKEY=
ASISTENTE_MODELO=
