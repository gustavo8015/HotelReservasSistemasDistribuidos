    // ---------------- reservas ----------------
    private void EditarReserva(ReservaResumen r)
    {
        editRes = r; confirmRes = null; aviso = null;
        var hab = (habitaciones ?? new List<HabitacionAdmin>()).FirstOrDefault(x => x.Numero == r.Habitacion);
        cambio = new CambioReserva
        {
            FechaEntrada = r.FechaEntrada, FechaSalida = r.FechaSalida, NumeroPersonas = r.NumeroPersonas,
            IdHabitacion = hab?.IdHabitacion ?? (habitaciones ?? new List<HabitacionAdmin>()).Select(x => x.IdHabitacion).FirstOrDefault(),
            VersionFila = r.VersionFila, Motivo = "",
        };
    }

    private async Task GuardarReserva()
    {
        if (editRes == null) return;
        ocupado = true; aviso = null;
        try
        {
            var r = await Api.ModificarReservaAsync(editRes.Codigo, cambio);
            Ok(r.Mensaje); editRes = null;
            reservas = await Api.ReservasAsync();
            habitaciones = await Api.HabitacionesAdminAsync();
        }
        catch (ApiException ex)
        {
            Error(ex.Message);
            reservas = await Api.ReservasAsync();
            await CargarGaleria();
        }
        finally { ocupado = false; }
    }

    private async Task EliminarReserva(ReservaResumen r)
    {
        ocupado = true; aviso = null; confirmRes = null;
        try
        {
            var res = await Api.EliminarReservaAsync(r.Codigo);
            Ok(res.Mensaje);
            reservas = await Api.ReservasAsync();
            habitaciones = await Api.HabitacionesAdminAsync();
        }
        catch (ApiException ex) { Error(ex.Message); }
        finally { ocupado = false; }
    }
